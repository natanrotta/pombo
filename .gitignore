# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.turbo/
*.tsbuildinfo

# Prisma generated client
apps/api/src/generated/

# Env files (keep *.example)
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
playwright-report/
test-results/
apps/web/e2e/.auth/
e2e/.auth/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code worktrees (created by /start-task or the desktop app)
.claude/worktrees/

# Claude Code runtime artifacts (never commit)
.claude/scheduled_tasks.lock
.claude/*.lock

# Claude Code local secrets — the Bugsnag personal auth token (Data Access API)
# and any future Claude-Code-only credential live here. NEVER versioned; only
# the *.example template + .gitkeep are committed.
.claude/.secrets/*
!.claude/.secrets/*.example
!.claude/.secrets/.gitkeep

# Deploy infra — real secrets NEVER versioned (only the *.example files are)
infra/.env.prod
infra/wireguard/wg0.conf
infra/wireguard/*.key
infra/wireguard/privatekey
infra/wireguard/publickey
infra/backup/backup.env
*.age.key
backup-age.key
