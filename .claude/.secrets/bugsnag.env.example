# Bugsnag — Claude Code local secrets (Data Access API)
# ----------------------------------------------------------------------------
# Copy this file to `bugsnag.env` (same dir) and fill in the token. The real
# file is gitignored — it must NEVER be committed. Only this *.example is
# tracked. The `/bugsnag` skill and the bugsnag CLI source `bugsnag.env`.
#
#   cp .claude/.secrets/bugsnag.env.example .claude/.secrets/bugsnag.env
#   # then paste your token below in the real file
#
# Get the token at: https://app.bugsnag.com  → Settings → My Account →
# Personal auth tokens → Generate new token (scope: read + write project
# settings if you want the CLI to set stability targets).
#
# SECURITY: this is a *personal* auth token — it can read every project and
# change account settings. Treat it like a password. If it ever leaks (chat,
# log, shared screen), rotate it immediately in the Bugsnag UI.

# Personal auth token (UUID-shaped). Required.
BUGSNAG_AUTH_TOKEN=

# Organization (optional cache — the CLI discovers the org live).
# BUGSNAG_ORG_ID: filled by `bugsnag.sh whoami` discovery if you want to pin it.
BUGSNAG_ORG_ID=
# BUGSNAG_ORG_SLUG: fill from `bugsnag.sh whoami` (the `slug:` column).
BUGSNAG_ORG_SLUG=

# Convenience project-id cache (optional — the CLI resolves names live).
# Fill from `bugsnag.sh projects` once the real Pombo project names are known
# (expected shape: one project per app per environment).
# BUGSNAG_PROJECT_API_PROD=     # Pombo API PROD
# BUGSNAG_PROJECT_WEB_PROD=     # Pombo Web PROD
# BUGSNAG_PROJECT_API_LOCAL=    # Pombo API LOCAL
# BUGSNAG_PROJECT_WEB_DEV=      # Pombo Web (dev)
