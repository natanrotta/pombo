# infra/deploy.env.example — deploy TARGETS, read on YOUR machine.
#
# Copy to infra/deploy.env (gitignored) and fill in. ONE file feeds both layers:
#   - the guided yarn commands (make-tag · deploy · rollback · monitor-status),
#     via scripts/lib/deploy-cli.mjs
#   - the advanced Makefile (deploy-direct · runner-setup · *-status · logs · backup-*)
#
# Precedence: a variable exported in your shell (or `make VAR=…`) always wins
# over this file. The repo ships NO real host on purpose — a command whose
# target is unset fails fast instead of touching someone else's infrastructure.
#
# Format: plain KEY=value — no quotes, no inline comments. No secrets here:
# hosts and URLs only (the production secrets live in infra/.env.prod on the
# APP host).

# Public API base — `/api/health` is appended (e.g. https://api.your-domain.tld).
API_URL=
# Web app and marketing site, probed by `yarn monitor-status` (optional).
WEB_URL=
SITE_URL=

# SSH targets of the Makefile + the DB block of `yarn monitor-status`.
APP_HOST=
DATA_HOST=
SSH_USER=root

# GitHub repo (owner/name) — runner registration and the default image name.
GH_REPO=
# API image. Default when blank: ghcr.io/<owner of GH_REPO, lowercase>/pombo-api
IMAGE=
