# infra/.env.prod.example — production env for the API container (APP host).
#
# On the APP host: copy to /opt/pombo/app/infra/.env.prod, replace every
# <PLACEHOLDER> (or blank the line to disable that optional integration) and:
#   chmod 640 infra/.env.prod   # root rw + the deploy runner group r (make runner-setup)
#
# Source of truth: apps/api/src/core/config/schema (Zod validates on boot and
# exits 1 on a missing/invalid var). Only DATABASE_URL and JWT_SECRET are
# required with no default. This file must document EVERY schema key (active
# or commented) — `apps/api/src/core/config/env-example.spec.ts` fails on drift.
#
# Values are read by `docker compose` (env_file): no quotes needed, and no
# inline `# comments` after a value.

# ================= CORE =================
NODE_ENV=production
# The container port. docker-compose.prod.yml publishes it on 127.0.0.1 only;
# Caddy is the public entry point.
API_PORT=3333
# Allowed CORS origin(s) — the web app domain. NEVER "*" in production.
ALLOWED_ORIGIN=https://app.example.com
LOG_LEVEL=info
# Graceful-shutdown ceiling — keep BELOW the compose stop_grace_period (60 s).
# SHUTDOWN_TIMEOUT_MS=30000

# ================ DATABASE ===============
# REQUIRED. The DATA host over the WireGuard tunnel (10.8.0.2).
DATABASE_URL=postgresql://pombo:<DB_PASSWORD>@10.8.0.2:5432/pombo

# ================= REDIS =================
REDIS_HOST=10.8.0.2
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_DB=0

# ================== JWT ==================
# REQUIRED, >= 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=<JWT_SECRET_AT_LEAST_32_CHARS>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Auth cookie domain shared between app/api.
COOKIE_DOMAIN=.example.com
# Optional — "Sign in with Google" (must match the web's VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>

# ========= PASSWORD RESET / EMAIL VERIFY =========
# Frontend base used in e-mail links.
FRONTEND_URL=https://app.example.com
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# EMAIL_VERIFICATION_PIN_TTL_MINUTES=15

# ============ MAIL (RESEND) — optional ===========
RESEND_API_KEY=<RESEND_API_KEY>
MAIL_FROM=Pombo <no-reply@example.com>
# Dev only — leave unset in production.
# MAIL_DEV_REDIRECT_TO=

# ========= OBJECT STORAGE (S3) — optional ========
# Media/avatars live here, OUTSIDE the pg_dump backup — enable bucket versioning.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
AWS_S3_BUCKET=<AWS_S3_BUCKET>

# ============= OBSERVABILITY =============
# Bugsnag notifier key of the API production project. Blank = no error
# reporting (a deployed API should always report).
BUGSNAG_API_KEY=<BUGSNAG_API_KEY>
# Stamped into the image by build-api.yml (APP_VERSION=vX.Y, GIT_COMMIT=<sha>)
# and surfaced at GET /api/health. Keep them COMMENTED: an env_file value would
# mask the real version and `yarn deploy` could never confirm the cutover.
# APP_VERSION=
# GIT_COMMIT=
# COMMIT_SHA=
# node_exporter of each host, bound to the tunnel IP (never public :9100).
METRICS_APP_URL=http://10.8.0.1:9100/metrics
METRICS_DATA_URL=http://10.8.0.2:9100/metrics
# Optional — read-only GitHub token + repo for the CI/CD run listing.
# GITHUB_ACTIONS_TOKEN=
# GITHUB_REPO=owner/repo

# ============= RATE LIMITING (defaults shown) =============
# RATE_LIMIT_GLOBAL_WINDOW_MS=300000
# RATE_LIMIT_GLOBAL_MAX=1000
# RATE_LIMIT_USER_WINDOW_MS=60000
# RATE_LIMIT_USER_MAX=200
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_PUBLIC_WINDOW_MS=900000
# RATE_LIMIT_PUBLIC_MAX=30
# Per-token limiter of the public /api/v1 surface.
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_API_MAX=120

# ========= WHATSAPP GATEWAY =========
# ON in production: this container is the ONE replica that owns the WhatsApp
# sockets (a Postgres advisory lock enforces it). An extra replica must run with
# WHATSAPP_ENABLED=false (and RUN_MIGRATIONS=false).
WHATSAPP_ENABLED=true
# DISCONNECT_DEBOUNCE_MS=30000
# RECONNECT_BASE_DELAY_MS=3000
# RECONNECT_MAX_DELAY_MS=300000
# OUTBOX_TTL_HOURS=24
# OUTBOX_PRUNE_INTERVAL_MS=3600000
# Per-device send throttle (anti-ban) — tune to the number's reputation.
# SEND_RATE_MAX=20
# SEND_RATE_WINDOW_MS=60000
# Human send pacer — ships dark; flip after validating on a real number.
# HUMAN_PACING_ENABLED=false
# TYPING_MS_PER_CHAR=50
# TYPING_MIN_MS=1500
# TYPING_MAX_MS=20000
# SEND_JITTER_PCT=0.3
# LONG_PAUSE_PROBABILITY=0.15
# LONG_PAUSE_MIN_MS=30000
# LONG_PAUSE_MAX_MS=120000
# Outbound webhook delivery (HMAC-signed, bounded retries).
# WEBHOOK_TIMEOUT_MS=5000
# WEBHOOK_MAX_ATTEMPTS=4
# WEBHOOK_RETRY_BASE_DELAY_MS=1000
# ADVISORY_LOCK_HEARTBEAT_MS=30000

# ======= REDIS READ-ASIDE CACHES (fail-open) =======
# CACHE_ENTITY_TTL_SECONDS=60
# Revocation-propagation window of a revoked API token (max 300).
# CACHE_API_TOKEN_TTL_SECONDS=60

# ===== CONTAINER ENTRYPOINT (apps/api/docker-entrypoint.sh — not the app) =====
# migrate-on-boot. Keep true with ONE replica; false on extra replicas, with
# `prisma migrate deploy` run once as a deploy step instead.
# RUN_MIGRATIONS=true
