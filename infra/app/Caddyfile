# infra/app/Caddyfile — reverse proxy + TLS do host de APP
#
# {$API_DOMAIN} (ex.: api.your-domain.tld, repassado pelo
# docker-compose.caddy.yml) → container da API em localhost:3333.
#
# ── Corpo e streaming ────────────────────────────────────────────────────────
# `flush_interval -1` desliga o buffering da resposta: um endpoint SSE /
# text/event-stream futuro chega em chunks (hoje a API não tem SSE — é inócuo).
# O corpo da requisição é repassado byte a byte: NÃO adicione `request_body` /
# `encode` que o alterem (um webhook de entrada assinado dependeria disso).
#
# ── TLS atrás do Cloudflare (proxy laranja) ──────────────────────────────────
# Decisão: Cloudflare Origin Certificate na origem + SSL "Full (strict)". Gere o
# cert em SSL/TLS → Origin Server e coloque os 2 arquivos em /etc/caddy/certs/
# no host (chmod 600 na key) — montados pelo docker-compose.caddy.yml. Sem ACME.
# Alternativas (não usadas): DNS-01 com o plugin Cloudflare do Caddy, ou
# registro "DNS only" só durante a 1ª emissão Let's Encrypt.
#
# ── IP real do cliente ───────────────────────────────────────────────────────
# O X-Forwarded-For vira o CF-Connecting-IP, e a API confia em 1 proxy
# (`trust proxy 1`) para o rate limit por IP. Esse header só é confiável se a
# origem aceitar 80/443 APENAS dos IPs do Cloudflare (ufw) — ver o backlog em
# .claude/knowledge/devops.md.

{$API_DOMAIN} {
	reverse_proxy localhost:3333 {
		# Disable buffering so SSE / streaming endpoints flush chunk by chunk.
		flush_interval -1

		# Repassa o IP real do cliente vindo do Cloudflare.
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}

	tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key

	log {
		output file /var/log/caddy/caddy-api.log
		format json
	}
}
